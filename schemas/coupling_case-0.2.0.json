{
  "$defs": {
    "BackupSource": {
      "additionalProperties": false,
      "description": "An explicit heat source that tops up what the plant cannot deliver.\n\nIt stands in series after the plant at the same connection. Its heat is always reported as\nits own ledger entry. Without a backup, a shortfall is reported as a deficit.",
      "properties": {
        "backup_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Backup Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_heat_w": {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        }
      },
      "required": [
        "backup_id",
        "description",
        "max_heat_w"
      ],
      "title": "BackupSource",
      "type": "object"
    },
    "Conflict_Annotated_float__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Known_Annotated_float__Strict_strict_True___"
          },
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "state": {
          "const": "conflict",
          "default": "conflict",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "Conflict[Annotated[float, Strict(strict=True)]]",
      "type": "object"
    },
    "Evidence_Annotated_float__Strict_strict_True___": {
      "discriminator": {
        "mapping": {
          "conflict": "#/$defs/Conflict_Annotated_float__Strict_strict_True___",
          "known": "#/$defs/Known_Annotated_float__Strict_strict_True___",
          "unknown": "#/$defs/Unknown"
        },
        "propertyName": "state"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Known_Annotated_float__Strict_strict_True___"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/Conflict_Annotated_float__Strict_strict_True___"
        }
      ]
    },
    "FlowControl": {
      "enum": [
        "follow_demand",
        "fixed"
      ],
      "title": "FlowControl",
      "type": "string"
    },
    "Known_Annotated_float__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "const": "known",
          "default": "known",
          "title": "State",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "title": "Known[Annotated[float, Strict(strict=True)]]",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a value came from.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "provenance_type": {
          "$ref": "#/$defs/ProvenanceType"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "provenance_type"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceType": {
      "enum": [
        "measured",
        "imported",
        "guideline",
        "user_supplied",
        "estimated",
        "inferred",
        "synthetic"
      ],
      "title": "ProvenanceType",
      "type": "string"
    },
    "TransmissionDesign": {
      "additionalProperties": false,
      "description": "The pipe pair of a route between the plant at the site and the connection.\n\nWith a design, the route is modelled in the network: its heat loss, its pressure loss and its\nelevation profile. Without one, the plant sits at the connection.",
      "properties": {
        "heat_transfer_coefficient_w_m2_k": {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        },
        "inner_diameter_m": {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        },
        "roughness_m": {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        }
      },
      "required": [
        "inner_diameter_m",
        "roughness_m",
        "heat_transfer_coefficient_w_m2_k"
      ],
      "title": "TransmissionDesign",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "state": {
          "const": "unknown",
          "default": "unknown",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "owner"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One coupled operating point: a source, a plant, a connection and an operating case.",
  "properties": {
    "backup": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackupSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "connection_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Connection Id",
      "type": "string"
    },
    "coupling_case_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Coupling Case Id",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "fixed_geothermal_mass_flow_kg_s": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flow_control": {
      "$ref": "#/$defs/FlowControl"
    },
    "network_pressure_lift_pa": {
      "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
    },
    "operating_case_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Operating Case Id",
      "type": "string"
    },
    "plant_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Plant Id",
      "type": "string"
    },
    "route_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Id"
    },
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_scenario_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Source Scenario Id",
      "type": "string"
    },
    "transmission": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransmissionDesign"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "coupling_case_id",
    "source_scenario_id",
    "plant_id",
    "connection_id",
    "operating_case_id",
    "flow_control",
    "network_pressure_lift_pa"
  ],
  "title": "CouplingCase",
  "type": "object"
}
