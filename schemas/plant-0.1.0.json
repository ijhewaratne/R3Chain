    "HeatPumpMap": {
      "additionalProperties": false,
      "description": "Tabulated heat pump performance from a manufacturer or another reviewed source.\n\nRows follow ``source_inlet_temperatures_k`` and columns follow\n``sink_outlet_temperatures_k``. The coefficient of performance is the condenser heat divided\nby the electrical input of the compressor. An operating point outside the table is outside\nthe map. It is never extrapolated.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "heating_cop_ratio": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Heating Cop Ratio",
          "type": "array"
        },
        "map_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Map Id",
          "type": "string"
        },
        "max_condenser_heat_w": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Max Condenser Heat W",
          "type": "array"
        },
        "sink_outlet_temperatures_k": {
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "title": "Sink Outlet Temperatures K",
          "type": "array"
        },
