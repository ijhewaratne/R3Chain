{
  "$defs": {
    "AmountBasis": {
      "enum": [
        "total",
        "per_year",
        "per_joule_heat",
        "per_joule_electricity"
      ],
      "title": "AmountBasis",
      "type": "string"
    },
    "Conflict_Annotated_float__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Known_Annotated_float__Strict_strict_True___"
          },
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "state": {
          "const": "conflict",
          "default": "conflict",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "Conflict[Annotated[float, Strict(strict=True)]]",
      "type": "object"
    },
    "CostCategory": {
      "enum": [
        "capex",
        "fixed_opex",
        "variable_cost",
        "replacement",
        "decommissioning",
        "residual_value"
      ],
      "title": "CostCategory",
      "type": "string"
    },
    "CostItem": {
      "additionalProperties": false,
      "description": "One line of the cost ledger.\n\n``asset_id`` and ``cost_owner`` exist so that a well, pump or exchanger already costed by\nthe source model is not added again downstream.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___",
          "unit": "currency"
        },
        "amount_basis": {
          "$ref": "#/$defs/AmountBasis"
        },
        "applies_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "asset_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CostCategory"
        },
        "cost_owner": {
          "minLength": 1,
          "title": "Cost Owner",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "item_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "lifetime_years": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "price_convention": {
          "$ref": "#/$defs/PriceConvention"
        },
        "price_year": {
          "title": "Price Year",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "asset_id",
        "category",
        "cost_owner",
        "location",
        "included",
        "amount",
        "amount_basis",
        "currency",
        "price_year",
        "price_convention"
      ],
      "title": "CostItem",
      "type": "object"
    },
    "CostScope": {
      "additionalProperties": false,
      "description": "Which candidates, assets or baseline a cost item belongs to.",
      "properties": {
        "alternative_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Alternative Ids",
          "type": "array"
        },
        "applies_to_baseline": {
          "default": false,
          "title": "Applies To Baseline",
          "type": "boolean"
        },
        "candidate_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "connection_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Connection Ids",
          "type": "array"
        },
        "plant_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Plant Ids",
          "type": "array"
        },
        "route_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Route Ids",
          "type": "array"
        },
        "site_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Site Ids",
          "type": "array"
        }
      },
      "title": "CostScope",
      "type": "object"
    },
    "Evidence_Annotated_float__Strict_strict_True___": {
      "discriminator": {
        "mapping": {
          "conflict": "#/$defs/Conflict_Annotated_float__Strict_strict_True___",
          "known": "#/$defs/Known_Annotated_float__Strict_strict_True___",
          "unknown": "#/$defs/Unknown"
        },
        "propertyName": "state"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Known_Annotated_float__Strict_strict_True___"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/Conflict_Annotated_float__Strict_strict_True___"
        }
      ]
    },
    "FundingRule": {
      "additionalProperties": false,
      "description": "A dated, sourced subsidy or grant rule kept separate from the unsubsidised case.",
      "properties": {
        "applies_to_replacements": {
          "title": "Applies To Replacements",
          "type": "boolean"
        },
        "categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CostCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "grant_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Grant Fraction",
          "type": "number"
        },
        "locations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Locations",
          "type": "array"
        },
        "reviewed": {
          "default": false,
          "title": "Reviewed",
          "type": "boolean"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "rule_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "title",
        "effective_date",
        "source_id",
        "grant_fraction",
        "applies_to_replacements"
      ],
      "title": "FundingRule",
      "type": "object"
    },
    "Known_Annotated_float__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "const": "known",
          "default": "known",
          "title": "State",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "title": "Known[Annotated[float, Strict(strict=True)]]",
      "type": "object"
    },
    "PriceConvention": {
      "enum": [
        "real",
        "nominal"
      ],
      "title": "PriceConvention",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a value came from.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "provenance_type": {
          "$ref": "#/$defs/ProvenanceType"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "provenance_type"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceType": {
      "enum": [
        "measured",
        "imported",
        "guideline",
        "user_supplied",
        "estimated",
        "inferred",
        "synthetic"
      ],
      "title": "ProvenanceType",
      "type": "string"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "state": {
          "const": "unknown",
          "default": "unknown",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "owner"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "carbon_monetised": {
      "default": false,
      "title": "Carbon Monetised",
      "type": "boolean"
    },
    "cost_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CostItem"
      },
      "title": "Cost Items",
      "type": "array"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "discount_rate_per_year": {
      "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
    },
    "economic_scenario_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Economic Scenario Id",
      "type": "string"
    },
    "funding_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FundingRule"
      },
      "title": "Funding Rules",
      "type": "array"
    },
    "horizon_years": {
      "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
    },
    "price_base_year": {
      "title": "Price Base Year",
      "type": "integer"
    },
    "price_convention": {
      "$ref": "#/$defs/PriceConvention"
    },
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "vat_included": {
      "title": "Vat Included",
      "type": "boolean"
    }
  },
  "required": [
    "economic_scenario_id",
    "price_base_year",
    "currency",
    "price_convention",
    "vat_included",
    "discount_rate_per_year",
    "horizon_years"
  ],
  "title": "EconomicScenario",
  "type": "object"
}
