{
  "$defs": {
    "Conflict_Annotated_float__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Known_Annotated_float__Strict_strict_True___"
          },
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "state": {
          "const": "conflict",
          "default": "conflict",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "Conflict[Annotated[float, Strict(strict=True)]]",
      "type": "object"
    },
    "Evidence_Annotated_float__Strict_strict_True___": {
      "discriminator": {
        "mapping": {
          "conflict": "#/$defs/Conflict_Annotated_float__Strict_strict_True___",
          "known": "#/$defs/Known_Annotated_float__Strict_strict_True___",
          "unknown": "#/$defs/Unknown"
        },
        "propertyName": "state"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Known_Annotated_float__Strict_strict_True___"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/Conflict_Annotated_float__Strict_strict_True___"
        }
      ]
    },
    "ExistingHeatSource": {
      "additionalProperties": false,
      "description": "An existing heat plant in the system (waste heat base load or peak/backup boiler).",
      "properties": {
        "availability": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeriesRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fuel_tariff": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeriesRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "max_heat_w": {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        },
        "min_output_w": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "title": "Priority",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/ExistingSourceRole"
        },
        "source_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "thermal_efficiency_fraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variable_om_currency_per_j": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_id",
        "label",
        "role",
        "priority",
        "max_heat_w"
      ],
      "title": "ExistingHeatSource",
      "type": "object"
    },
    "ExistingSourceRole": {
      "enum": [
        "base_load",
        "peak_backup"
      ],
      "title": "ExistingSourceRole",
      "type": "string"
    },
    "Known_Annotated_float__Strict_strict_True___": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "const": "known",
          "default": "known",
          "title": "State",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "title": "Known[Annotated[float, Strict(strict=True)]]",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a value came from.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "provenance_type": {
          "$ref": "#/$defs/ProvenanceType"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "provenance_type"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceType": {
      "enum": [
        "measured",
        "imported",
        "guideline",
        "user_supplied",
        "estimated",
        "inferred",
        "synthetic"
      ],
      "title": "ProvenanceType",
      "type": "string"
    },
    "SeriesRef": {
      "additionalProperties": false,
      "description": "A time series inside a registered dataset.",
      "properties": {
        "dataset_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "series_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Series Id",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "dataset_id"
      ],
      "title": "SeriesRef",
      "type": "object"
    },
    "SourceAvailability": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/SeriesRef"
        },
        "source_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "availability"
      ],
      "title": "SourceAvailability",
      "type": "object"
    },
    "TimeBasis": {
      "additionalProperties": false,
      "properties": {
        "end_utc": {
          "format": "date-time",
          "title": "End Utc",
          "type": "string"
        },
        "interval_s": {
          "exclusiveMinimum": 0.0,
          "title": "Interval S",
          "type": "number"
        },
        "presentation_timezone": {
          "default": "Europe/Berlin",
          "title": "Presentation Timezone",
          "type": "string"
        },
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        }
      },
      "required": [
        "start_utc",
        "end_utc",
        "interval_s"
      ],
      "title": "TimeBasis",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "state": {
          "const": "unknown",
          "default": "unknown",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "owner"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Demand, source availability, temperature requirements, tariffs and dispatch policy.\n\nDemand, tariffs and availability must cover the same intervals. That is checked against the\nactual series by ``validate_scenario``.",
  "properties": {
    "demand": {
      "$ref": "#/$defs/SeriesRef"
    },
    "dispatch_policy_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Dispatch Policy Id",
      "type": "string"
    },
    "distribution_loss_fraction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "electricity_tariff": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeriesRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "existing_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExistingHeatSource"
      },
      "title": "Existing Sources",
      "type": "array"
    },
    "geothermal_availability": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeriesRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "geothermal_min_output_fraction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence_Annotated_float__Strict_strict_True___"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "heat_revenue_tariff": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeriesRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operating_scenario_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Operating Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_availability": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceAvailability"
      },
      "title": "Source Availability",
      "type": "array"
    },
    "tariffs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SeriesRef"
      },
      "title": "Tariffs",
      "type": "array"
    },
    "temperature_curves": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SeriesRef"
      },
      "title": "Temperature Curves",
      "type": "array"
    },
    "time_basis": {
      "$ref": "#/$defs/TimeBasis"
    }
  },
  "required": [
    "operating_scenario_id",
    "demand",
    "dispatch_policy_id",
    "time_basis"
  ],
  "title": "OperatingScenario",
  "type": "object"
}
