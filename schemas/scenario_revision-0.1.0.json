{
  "$defs": {
    "ChangeKind": {
      "enum": [
        "added",
        "removed",
        "changed"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "FieldChange": {
      "additionalProperties": false,
      "description": "One field level difference between two scenario revisions.",
      "properties": {
        "after": {
          "default": null,
          "title": "After"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        }
      },
      "required": [
        "field_path",
        "kind"
      ],
      "title": "FieldChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FieldChange"
      },
      "title": "Changes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision Id"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Revision Id",
      "type": "string"
    },
    "scenario_hash": {
      "title": "Scenario Hash",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "revision_id",
    "scenario_id",
    "scenario_hash",
    "created_at",
    "author",
    "rationale"
  ],
  "title": "ScenarioRevision",
  "type": "object"
}
