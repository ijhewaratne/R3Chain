{
  "$defs": {
    "AdapterState": {
      "description": "Outcome of one engine call (specification 7.4).",
      "enum": [
        "completed",
        "invalid_input",
        "unsupported_model",
        "non_converged",
        "physical_limit_exceeded",
        "cancelled",
        "tool_failure"
      ],
      "title": "AdapterState",
      "type": "string"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One engineering check with its threshold, origin, observed value and margin.",
      "properties": {
        "check_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
          "title": "Check Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit",
          "unit": "see unit"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin",
          "unit": "see unit"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed",
          "unit": "see unit"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "threshold_origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Origin"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "check_id",
        "description",
        "outcome"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckOutcome": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated"
      ],
      "title": "CheckOutcome",
      "type": "string"
    },
    "OutputSemantics": {
      "description": "What a reported output means (specification 7.4).",
      "enum": [
        "available_capacity",
        "dispatched_output",
        "requested_value_achieved"
      ],
      "title": "OutputSemantics",
      "type": "string"
    },
    "Pressure": {
      "additionalProperties": false,
      "description": "A pressure together with its reference.",
      "properties": {
        "reference": {
          "$ref": "#/$defs/PressureReference"
        },
        "value_pa": {
          "title": "Value Pa",
          "type": "number"
        }
      },
      "required": [
        "value_pa",
        "reference"
      ],
      "title": "Pressure",
      "type": "object"
    },
    "PressureReference": {
      "enum": [
        "absolute",
        "gauge"
      ],
      "title": "PressureReference",
      "type": "string"
    },
    "SourcePerformance": {
      "additionalProperties": false,
      "description": "Performance at the wellhead, the physical handover point.\n\nWellbore losses and pumping are already inside these numbers. Nothing downstream may deduct\nthem a second time.",
      "properties": {
        "electrical_pump_power_w": {
          "minimum": 0.0,
          "title": "Electrical Pump Power W",
          "type": "number"
        },
        "geothermal_extracted_heat_w": {
          "exclusiveMinimum": 0.0,
          "title": "Geothermal Extracted Heat W",
          "type": "number"
        },
        "heat_semantics": {
          "$ref": "#/$defs/OutputSemantics"
        },
        "injection_pressure_rise_pa": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Injection Pressure Rise Pa"
        },
        "injection_temperature_k": {
          "exclusiveMinimum": 0.0,
          "title": "Injection Temperature K",
          "type": "number"
        },
        "injection_wellhead_pressure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pressure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mass_flow_kg_s": {
          "exclusiveMinimum": 0.0,
          "title": "Mass Flow Kg S",
          "type": "number"
        },
        "mass_flow_semantics": {
          "$ref": "#/$defs/OutputSemantics"
        },
        "production_drawdown_pa": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Drawdown Pa"
        },
        "production_wellhead_pressure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pressure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wellhead_production_temperature_k": {
          "exclusiveMinimum": 0.0,
          "title": "Wellhead Production Temperature K",
          "type": "number"
        }
      },
      "required": [
        "mass_flow_kg_s",
        "mass_flow_semantics",
        "wellhead_production_temperature_k",
        "injection_temperature_k",
        "geothermal_extracted_heat_w",
        "heat_semantics",
        "electrical_pump_power_w"
      ],
      "title": "SourcePerformance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_limits": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Active Limits",
      "type": "array"
    },
    "artifact_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "economics_calculated": {
      "default": false,
      "title": "Economics Calculated",
      "type": "boolean"
    },
    "engine": {
      "minLength": 1,
      "title": "Engine",
      "type": "string"
    },
    "engine_version": {
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "fidelity": {
      "minLength": 1,
      "title": "Fidelity",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "iterations_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Iterations Count"
    },
    "model_family": {
      "minLength": 1,
      "title": "Model Family",
      "type": "string"
    },
    "not_calculated": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Not Calculated",
      "type": "array"
    },
    "performance": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcePerformance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_request": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Request"
    },
    "raw_result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Result"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_scenario_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]*$",
      "title": "Source Scenario Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/AdapterState"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "engine",
    "engine_version",
    "fidelity",
    "model_family",
    "source_scenario_id",
    "input_hash",
    "sample_id",
    "state",
    "synthetic"
  ],
  "title": "SourceResult",
  "type": "object"
}
